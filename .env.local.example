# =====================================================================
# SINZA UNIVERSAL COMPANY — sample .env.local
# Copy to .env.local and fill in the real values. Never commit .env.local.
# =====================================================================

# --- Database (PostgreSQL + Drizzle) --------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Site -----------------------------------------------------------
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin console (username + password ONLY — never Clerk) ----------
ADMIN_USERNAME="your username"
ADMIN_EMAIL="your email"
ADMIN_PASSWORD="you password"
SESSION_SECRET=change-this-to-a-long-random-string-before-production

# --- Email (Resend) -------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Sinza Universal Company <news@sinzauniversal.com>"

# --- Social sync (Apify) --------------------------------------------
APIFY_TOKEN="apify_api_you_api"
YOUTUBE_HANDLE="you youtube handle"
INSTAGRAM_HANDLE="your ig handle"
FACEBOOK_PAGE="you fb page"
X_HANDLE="you x or twitter handle"

# --- File storage (Cloudflare R2) -----------------------------------
# Leave blank to store uploads in /public/uploads instead.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=sinza-universal
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://cdn.sinzauniversal.com

# --- Payments: Pesapal (Visa / Mastercard / mobile money) -----------
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_IPN_ID=

# --- Payments: pawaPay (MTN MoMo / Airtel Money) --------------------
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.pawapay.io

# true  = payments are simulated instantly (safe for development)
# false = live gateways are used
PAYMENTS_DEMO=true

# --- Cron -----------------------------------------------------------
CRON_SECRET=replace-with-a-long-random-string

# --- Optional: visitor accounts (never used for the admin) ----------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
